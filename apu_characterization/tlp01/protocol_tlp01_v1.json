  "claim_under_test": "HISTORICAL tlp01_v1 template — superseded by tlp01_v2. Do not quote. Agent workloads contain measurable latent turn-level parallelism under in-order harness loops.",
  "study_form": "trace_driven_limit_study",
  "pre_registered_null": "Tier-C TLP < 1.5x broadly; agents are inherently serial at the turn level and the in-order loop is near-optimal.",
  "validity_class": "turn_level_parallelism",
  "phases": {
    "T0": "trace_collection",
    "T1": "dependence_graph_construction",
    "T2": "scheduling_simulation"
  },
  "trace_sources": {
    "S1": {
      "name": "existing_artifacts",
      "description": "Extraction from promoted mock-sweep and live-ladder run directories; standing task suite classes SO/RE/SH/CH/CN/FO/LH/RH.",
      "requires_live_model": false,
      "required_for_v1": true
    },
    "S2": {
      "name": "fresh_multi_tool_traces",
      "description": "Live OpenAI harness on tasks designed to contain independent tool calls.",
      "requires_live_model": true,
      "backend": "openai",
      "target_sessions": 50,
      "seeds": 5,
      "temperature": 0,

#!/bin/bash
# T2S P11-B window (Task BB; supersedes the P11 M/S phases of run_window_t2s_hang.sh for the
# entry-123 question; $0, local only, entry 123 only).
#   Registered before any run: docs/amendments/DEMO2_PILOT_P11B_2026-10-21.md (decision rules fixed).
#   Inputs pinned: derived/repro_hang123/p11b/INDEX.json (sha256 in the note).
# Safety as run_window_t2s.sh / run_window_t2s_hang.sh:
#   - before every launch: Rithwik check ($PID excluded), banned apps, watchdog launch-check, clean tree;
#   - park/copy to ~/seam_closeout_1013/t2s/window_<stamp>_p11b/;
#   - nothing that is not ours is killed. Every cell ends itself (in-process watchdog, exit 86).
# Watchdogs (registered): runner cells -StallWatchdogS 900 -TurnWatchdogS 3600 -LocalTurnLimit 1;
#   repro cells --stall-s 900 --watchdog-s 1800 (per generate). 900 s, not 300 s: the step-1
#   prefill of 85,077 new tokens took about 340 s on this host with no token (8af10211, DERIVED).
# REBOOT_OK=1 required. Reboot at window start and after every watchdog fire or generate error;
#   reboot wait up to 20 min.
# Order (index): 0 X0 arm A | 1 X1 arm A + cap 40,960 | 2-6 X2 random N 32,768 40,960 49,152
#   65,536 87,392 | 7 X3 (NOT_TESTED by rule; X3R=1 runs the reconstructed input X3r) |
#   8 X4-C2 chunk 4096 | 9 X4-C3 chunk 256.
# Budget: cells start only while the window's cell time stays within 2.5 h (9,000 s from the first
#   launch) and only if their reserve ends before 21:44 ET 2026-10-25; a cell that does not fit is
#   NOT_RUN (budget) and the next one is tried. Hand-back check at every stop and at the end.
# Time (DERIVED from 8af10211, 9b4cdefb and daa6c026 on this host): start ~8 min; X0 ~30 min
#   (turn 0 to the 21-step limit: step 1 ~400 s + ~60 s per later step; 60 min budget); X1 ~4 min;
#   X2 ~40 min (prefill ~0.047 s x (N/1000)^2 + 5 x 512-token decodes); X4 2 x ~30 min (60 min
#   each max). Typical ~2 h, cell budget 2.5 h, worst case stops at the budget.
# Run with:  REBOOT_OK=1 caffeinate -i bash ~/seam_closeout_1013/xps/run_window_t2s_hang.sh
# Resume:    REBOOT_OK=1 FROM=<index> caffeinate -i bash ~/seam_closeout_1013/xps/run_window_t2s_hang.sh
set -u
FROM=${FROM:-0}
X3R=${X3R:-0}
REBOOT_OK=${REBOOT_OK:-0}
EXPECT_HEAD=328de13
PIN_SHA=CC74A37ED84ED95B0F4DD4B8D7EB774F2737230DCFCA01321FE136CDBFBCA447
MAC_REPO=~/gnn-hls-accel
P11B_INDEX="$MAC_REPO/derived/repro_hang123/p11b/INDEX.json"
STALL_S=900
TURN_S=3600
REPRO_GEN_S=1800
BUDGET_S=9000
DEADLINE=$(TZ=America/New_York date -j -f "%Y-%m-%d %H:%M:%S" "2026-10-25 21:44:00" +%s)
OUT=~/seam_closeout_1013/t2s/window_$(date +%Y%m%d_%H%M)_p11b
mkdir -p "$OUT"
X=zach@100.72.40.24
R='C:\Users\zach\Projects\gnn-hls-accel'
PY="$R\\.venv-seam\\Scripts\\python.exe"
PYSPY_EXE='C:\Users\zach\seam_tools\py-spy.exe'
PYSPY=""
MAC_REPO=~/gnn-hls-accel
log(){ echo "[$(TZ=America/New_York date '+%m-%d %H:%M:%S ET')] $*" | tee -a "$OUT/steps.txt"; }
xs(){ ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 "$X" "$1" 2>&1 | tr -d '\r'; }
handback(){
  log "hand-back check (no python of ours, tree clean; Rithwik has the T2S Oct 26 - Nov 8)"
  xs "cd $R; git status --short; \"PYTHON_COUNT=\" + @(Get-Process python -ErrorAction SilentlyContinue).Count" | tee "$OUT/handback.txt"
}
stop(){ log "STOP: $*"; handback; exit 1; }
banned(){ xs 'Get-Process | Where-Object { $_.ProcessName -match "^(cursor|chrome|msedge|code|claude|python|ollama.*)$" } | Select-Object -ExpandProperty ProcessName' | sort -u | tr '\n' ' '; }
drv_summary(){ tr -d '\r' < "$1" | awk '/^DeviceName/{n=$0; sub(/^DeviceName *: */,"",n)} /^DriverVersion/{v=$0; sub(/^DriverVersion *: */,"",v); if (n ~ /Graphics|GPU|Arc|NPU/ && n !~ /Input/) printf "%s %s; ", n, v}'; }
rithwik(){ xs 'Get-CimInstance Win32_Process | Where-Object { $_.ProcessId -ne $PID -and ($_.CommandLine -match "t2s_r2_agent" -or $_.Name -match "^ollama") } | ForEach-Object { "{0} {1}" -f $_.ProcessId, $_.Name }' | tr '\n' ' '; }
watchdog_ok(){ xs "cd $R; \$n = @(Get-Process -Name python, llama-server -ErrorAction SilentlyContinue | ForEach-Object { \$_.ProcessName }); if (\$n.Count -eq 0) { \$j = '[]' } else { \$j = ConvertTo-Json -InputObject @(\$n) -Compress }; & '$PY' tools\\t2s_queue_watchdog.py launch-check --log C:\\apu\\ovn\\watchdog.log --running-json \$j; \"RC=\$LASTEXITCODE\"" > "$OUT/watchdog_check_$1.txt"; grep -q '^RC=0' "$OUT/watchdog_check_$1.txt"; }
guard(){
  local r=$(rithwik); [ -z "${r// }" ] || stop "Rithwik's process running before $1: $r"
  local b=$(banned); [ -z "${b// }" ] || stop "banned/foreign process before $1: $b (nothing is killed on the T2S)"
  watchdog_ok "$1" || stop "T2S watchdog launch-check refused before $1 (see watchdog_check_$1.txt)"
}
uptime_s(){ xs '[int]((Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime).TotalSeconds' | tr -dc '0-9'; }
wait_python(){ local t0=$(date +%s); while true; do n=$(xs '@(Get-Process python -ErrorAction SilentlyContinue).Count' | tr -dc '0-9'); [ "${n:-0}" = "0" ] && break; [ $(( $(date +%s) - t0 )) -gt 5400 ] && stop "python still running after 90 min (the in-process watchdog should have ended it; nothing is killed)"; sleep 20; done; }
clean_tree(){ s=$(xs "cd $R; git status --porcelain"); [ -z "$s" ] || stop "dirty tree: $s"; }
park(){ log "park $1"; xs "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\Users\\zach\\seam_tools\\park_untracked_t2s.ps1 -Label $1" | tee "$OUT/park_$1.txt"; grep -q '^MODIFIED' "$OUT/park_$1.txt" && stop "tracked file modified after $1"; { scp -q -r "$X:C:/Users/zach/gnn_backup_demo2/pending_closeout/$1" "$OUT/" || scp -O -q -r "$X:C:/Users/zach/gnn_backup_demo2/pending_closeout/$1" "$OUT/"; } && log "copied $1 to Mac" || log "WARN copy of $1 failed; it is safe on the T2S in pending_closeout"; }
field(){ grep -m1 "^$1" "$2" | sed 's/^[^:]*: //' | tr -d '\r'; }
reboot_t2s(){
  [ "$REBOOT_OK" = "1" ] || stop "reboot needed ($1) but REBOOT_OK is not set"
  log "reboot ($1)"; xs 'shutdown /r /t 5' >/dev/null; sleep 90
  T0=$(date +%s); until ssh -o BatchMode=yes -o ConnectTimeout=5 "$X" hostname >/dev/null 2>&1; do [ $(( $(date +%s) - T0 )) -gt 1200 ] && { log "STOP: T2S did not come back on ssh within 20 min of reboot"; exit 1; }; sleep 10; done; log "T2S back (uptime $(uptime_s) s)"; sleep 120
}

T_FIRST=""
fits(){ # $1 label, $2 reserve s, $3 index: 0 if the cell may start
  local now=$(date +%s)
  [ $(( now + $2 )) -lt $DEADLINE ] || { log "NOT_RUN (deadline 21:44 ET Oct 25): $1 (index $3)"; echo "$1 rc=NOT_RUN_DEADLINE" >> "$OUT/cells.txt"; return 1; }
  if [ -n "$T_FIRST" ] && [ $(( now - T_FIRST + $2 )) -gt $BUDGET_S ]; then log "NOT_RUN (2.5 h cell budget): $1 (index $3)"; echo "$1 rc=NOT_RUN_BUDGET" >> "$OUT/cells.txt"; return 1; fi
  [ -n "$T_FIRST" ] || T_FIRST=$now
  return 0
}
fired(){ grep -o -m1 -E 'TURN_WATCHDOG_[A-Z_]+' "$1" 2>/dev/null; }
p11b_sha(){ python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['cells'][sys.argv[2]]['file_sha256'])" "$P11B_INDEX" "$1"; }

repro_cell(){ # $1 label, $2 cell name in p11b/INDEX.json; rc 0 done, 2 watchdog fired, 3 generate error, 1 refused
  local lbl=$1 name=$2
  clean_tree; guard "$lbl"
  local sh=$(p11b_sha "$name")
  local lg="derived\\c2_ttft\\_launches\\p11b\\$lbl.log"
  local cmd="tools\\repro_hang123.py run --inputs derived\\repro_hang123\\p11b\\$name.json --inputs-sha256 $sh --chain-steps 4 --stall-s $STALL_S --watchdog-s $REPRO_GEN_S --out-dir derived\\repro_hang123\\runs --label $lbl"
  [ -n "$PYSPY" ] && cmd="$cmd --py-spy $PYSPY"
  log "launch $lbl (uptime $(uptime_s) s): repro chain $name"
  xs "cd $R; New-Item -ItemType Directory -Force (Split-Path $lg) | Out-Null; powershell -NoProfile -File tools\\spawn_detached.ps1 -CommandLine \"set SEAM_LAUNCH_CONTEXT=ssh_detached&& set SEAM_PLATFORM_ID=evo-t2&& $PY -u $cmd\" -LogPath $lg -WorkingDirectory $R" > "$OUT/${lbl}_launch.txt"
  sleep 30; wait_python; log "$lbl exited"
  scp -q "$X:$(echo "$R\\$lg" | tr '\\' '/')" "$OUT/${lbl}.log" 2>/dev/null || xs "Get-Content '$R\\$lg'" > "$OUT/${lbl}.log"
  local rc=1 f=$(fired "$OUT/${lbl}.log")
  if [ -n "$f" ]; then rc=2
  elif grep -q '^GENERATE_ERROR' "$OUT/${lbl}.log"; then rc=3
  elif grep -q '^REPRO_DONE' "$OUT/${lbl}.log"; then rc=0; fi
  grep -m1 '^RUN_ID' "$OUT/${lbl}.log" | sed "s/^/$lbl /" >> "$OUT/run_ids.txt"
  park "$lbl"
  echo "$lbl rc=$rc fired=${f:-none}" >> "$OUT/cells.txt"
  log "$lbl rc=$rc ${f:-no watchdog fire}"
  return $rc
}
runner_cell(){ # $1 label, rest launch_h1 args (-T2S added); rc 0 done, 2 watchdog fired, 1 refused/error
  local lbl=$1; shift
  clean_tree; guard "$lbl"
  log "launch $lbl (uptime $(uptime_s) s)"
  xs "cd $R; powershell -NoProfile -File tools\\launch_h1.ps1 -T2S $*" > "$OUT/${lbl}_launch.txt"
  if ! grep -q 'Spawned' "$OUT/${lbl}_launch.txt"; then
    grep -E 'REFUSED|refusal|FAILED' "$OUT/${lbl}_launch.txt" | head -5 | tee -a "$OUT/steps.txt"
    park "${lbl}_refused"; echo "$lbl rc=1 fired=none" >> "$OUT/cells.txt"; log "$lbl NOT_TESTED (did not spawn)"; return 1
  fi
  local rid=$(field 'session_id (run_id)' "$OUT/${lbl}_launch.txt"); local ll=$(field 'launch_log' "$OUT/${lbl}_launch.txt"); local ev=$(field 'launch_evidence_dir' "$OUT/${lbl}_launch.txt")
  log "$lbl run_id $rid"; echo "$lbl $rid" >> "$OUT/run_ids.txt"
  sleep 60; wait_python; log "$lbl worker exited"
  xs "Get-Content '$ll' -Tail 200" > "$OUT/${lbl}_logtail.txt"
  local rc=0 f=$(fired "$OUT/${lbl}_logtail.txt")
  if [ -n "$f" ]; then rc=2
  elif grep -E -q 'REFUSED|Traceback|ARM_A_INVALID|FAIL_CANARY' "$OUT/${lbl}_logtail.txt"; then rc=1; fi
  scp -q -r "$X:$(echo "$ev" | tr '\\' '/')" "$OUT/launch_${lbl}_$rid" 2>/dev/null
  scp -q "$X:$(echo "$ll" | tr '\\' '/')" "$OUT/${lbl}_worker.log" 2>/dev/null || log "WARN worker log copy failed for $lbl"
  park "$lbl"
  echo "$lbl rc=$rc fired=${f:-none} run_id=$rid" >> "$OUT/cells.txt"
  log "$lbl rc=$rc ${f:-no watchdog fire}"
  return $rc
}
after_cell(){ if [ "$1" = "2" ] || [ "$1" = "3" ]; then reboot_t2s "after a watchdog fire or error"; clean_tree; fi; }

log "start T2S P11-B window (FROM=$FROM X3R=$X3R REBOOT_OK=$REBOOT_OK); output in $OUT"
case "$EXPECT_HEAD" in *PLACEHOLDER*) stop "EXPECT_HEAD not set in this script";; esac
[ "$REBOOT_OK" = "1" ] || { log "STOP: this window needs REBOOT_OK=1"; exit 1; }
[ -f "$P11B_INDEX" ] || { log "STOP: $P11B_INDEX missing (Mac repo not at the pushed head?)"; exit 1; }
ssh -o BatchMode=yes -o ConnectTimeout=15 "$X" hostname >/dev/null 2>&1 || { log "STOP: T2S not reachable over ssh"; exit 1; }
B64=$(base64 < ~/seam_closeout_1013/t2s/tools/park_untracked_t2s.ps1 | tr -d '\n')
xs "New-Item -ItemType Directory -Force C:\\Users\\zach\\seam_tools | Out-Null; [IO.File]::WriteAllBytes('C:\\Users\\zach\\seam_tools\\park_untracked_t2s.ps1', [Convert]::FromBase64String('$B64')); (Get-FileHash C:\\Users\\zach\\seam_tools\\park_untracked_t2s.ps1).Hash" | tee "$OUT/park_tool_hash.txt"
grep -q -E '^[0-9A-F]{64}' "$OUT/park_tool_hash.txt" || stop "could not write park_untracked_t2s.ps1 on the T2S"
xs 'hostname; [int]((Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime).TotalSeconds' | tee "$OUT/a_host_uptime.txt"
r=$(rithwik); [ -z "${r// }" ] || stop "Rithwik's process running: $r"
b=$(banned); [ -z "${b// }" ] || stop "banned/foreign process running: $b"
xs 'Get-ItemProperty "HKLM:\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings" -ErrorAction SilentlyContinue | Select-Object PauseUpdatesStartTime,PauseUpdatesExpiryTime | Format-List' | tee "$OUT/a_windows_update_pause.txt"
WU=$(grep -m1 'PauseUpdatesExpiryTime' "$OUT/a_windows_update_pause.txt" | sed 's/^[^:]*: *//'); [ -n "$WU" ] && log "Windows Update paused until $WU" || log "WARN Windows Update NOT paused"
xs 'Get-CimInstance Win32_PnPSignedDriver | Where-Object { $_.DeviceClass -eq "DISPLAY" -or $_.DeviceName -match "NPU" } | Select-Object DeviceName,DriverVersion,DriverDate,InfName,DeviceID | Format-List' > "$OUT/a_drivers.txt"
grep -q 'DriverVersion' "$OUT/a_drivers.txt" && log "drivers recorded: $(drv_summary "$OUT/a_drivers.txt")" || log "WARN driver query returned nothing (see a_drivers.txt)"
watchdog_ok a || stop "T2S watchdog launch-check refused (see watchdog_check_a.txt)"
B64=$(base64 < "$MAC_REPO/tools/get_pyspy.ps1" | tr -d '\n')
xs "[IO.File]::WriteAllBytes('C:\\Users\\zach\\seam_tools\\get_pyspy.ps1', [Convert]::FromBase64String('$B64')); powershell -NoProfile -ExecutionPolicy Bypass -File C:\\Users\\zach\\seam_tools\\get_pyspy.ps1; \"RC=\$LASTEXITCODE\"" | tee "$OUT/pyspy.txt"
PRC=$(grep -m1 '^RC=' "$OUT/pyspy.txt" | tr -dc '0-9')
if [ "$PRC" = "0" ] && grep -q '^PIP_FREEZE_UNCHANGED' "$OUT/pyspy.txt"; then PYSPY="$PYSPY_EXE"; log "py-spy ready"
elif [ "$PRC" = "4" ]; then stop "pip freeze of .venv-seam changed during the py-spy fetch (see pyspy.txt)"
else log "py-spy not available (rc ${PRC:-none}); cells run without a native dump"; fi
reboot_t2s "window start"
xs "cd $R; git pull --ff-only; Remove-Item derived\\h1_hybrid\\demo2\\DEMO2_HELDOUT_60.json; git checkout -- derived/h1_hybrid/demo2/DEMO2_HELDOUT_60.json; (Get-FileHash -Algorithm SHA256 derived\\h1_hybrid\\demo2\\DEMO2_HELDOUT_60.json).Hash; git log -1 --format=%h; git status --short" | tee "$OUT/b_pull_pin.txt"
grep -q "^$PIN_SHA" "$OUT/b_pull_pin.txt" || stop "DEMO2_HELDOUT_60 hash after restore is not $PIN_SHA"
grep -q "^${EXPECT_HEAD:0:7}" "$OUT/b_pull_pin.txt" || stop "T2S head is not $EXPECT_HEAD after the pull"
clean_tree; log "pulled to $EXPECT_HEAD, pin restored, tree clean"

ONE='-Entries derived\h1_hybrid\demo1\DEMO1_LONGCTX_30.json -EntryOffset 14 -EntryCount 1'
COMMON='-Interleaved -InterleavedPolicies local_only -PolicyCapUsd local_only=0 -SessionMaxUsd 1 -Placement gpu_only -Residency RESIDENT -DebugRawText -MemTelemetry -GpuMemCounters -StepLog -LocalTurnLimit 1'
WD="-StallWatchdogS $STALL_S -TurnWatchdogS $TURN_S"; [ -n "$PYSPY" ] && WD="$WD -HangDumpPySpy $PYSPY"
# index|kind|label|reserve_s|args or p11b cell
PLAN=(
  "0|runner|p11b_x0_armA|4500|-Kv default -RequireTrueDefault"
  "1|runner|p11b_x1_cap40960|900|-Kv default -RequireTrueDefault -CtxOverflowLocalFail -ContextWindow 40960"
  "2|repro|p11b_x2_n32768|900|X2_N32768"
  "3|repro|p11b_x2_n40960|900|X2_N40960"
  "4|repro|p11b_x2_n49152|1200|X2_N49152"
  "5|repro|p11b_x2_n65536|1500|X2_N65536"
  "6|repro|p11b_x2_n87392|1800|X2_N87392"
  "7|x3|p11b_x3r_reconstructed|1800|X3r_reconstructed"
  "8|runner|p11b_x4_c2_chunk4096|4500|-Kv default -CompiledReadback -SchedPrefixCaching on -SchedMaxBatchedTokens 4096"
  "9|runner|p11b_x4_c3_chunk256|4500|-Kv default -CompiledReadback -SchedPrefixCaching on -SchedMaxBatchedTokens 256"
)
for row in "${PLAN[@]}"; do
  IFS='|' read -r idx kind lbl reserve arg <<< "$row"
  [ "$idx" -ge "$FROM" ] || continue
  if [ "$kind" = "x3" ] && [ "$X3R" != "1" ]; then
    log "X3 NOT_TESTED: the real step-1 input was not recorded (8af10211); X3r runs only with X3R=1"
    echo "p11b_x3 rc=NOT_TESTED" >> "$OUT/cells.txt"; continue
  fi
  fits "$lbl" "$reserve" "$idx" || continue
  rc=0
  case $kind in
    runner) runner_cell "$lbl" $COMMON $arg $WD $ONE || rc=$?;;
    *) repro_cell "$lbl" "$arg" || rc=$?;;
  esac
  [ "$idx" -lt 9 ] && after_cell $rc
done
log "T2S P11-B window done (cells.txt); closeout applies the registered rules"
handback
exit 0
